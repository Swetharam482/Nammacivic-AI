# ==============================================================================
# NammaCivic AI - Environment Configuration Template
# Copy this file to .env and configure your secrets:
#   Windows PowerShell: Copy-Item .env.example .env
# ==============================================================================

# Project & Security Settings
PROJECT_NAME="NammaCivic AI"
API_V1_STR="/api/v1"
SECRET_KEY="your-random-32-character-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Database Configuration (PostgreSQL / SQLite)
# ==============================================================================
# Backend-only variable: Never expose this to the frontend.
# Supported dialects: PostgreSQL (via psycopg2) or SQLite fallback.

# Option 1A: Local PostgreSQL via DATABASE_URL
# Replace <your_postgres_password> with your actual pgAdmin / postgres user password:
# DATABASE_URL="postgresql://postgres:<your_postgres_password>@localhost:5432/Nammacivic AI"

# Option 1B: Local PostgreSQL via individual variables (safest if password contains special characters like @, #, :)
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="<your_postgres_password>"
# POSTGRES_SERVER="localhost"
# POSTGRES_PORT=5432
# POSTGRES_DB="Nammacivic AI"

# Option 2: Cloud Managed PostgreSQL (Supabase / Neon / Render / Railway / AWS RDS)
# Note: Append ?sslmode=require for cloud services requiring SSL
# DATABASE_URL="postgresql://user:password@ep-host-region.aws.neon.tech/nammacivic?sslmode=require"

# Option 3: Local SQLite fallback (default for rapid offline development without PostgreSQL)
DATABASE_URL="sqlite:///./nammacivic.db"

# ==============================================================================
# AI Conversational Assistant Settings
# ==============================================================================
# AI Provider Options:
#   "fallback" - Built-in offline NLP engine (supports Tamil, Tanglish, and English)
#   "gemini"   - Google Gemini API (requires GEMINI_API_KEY)
#   "openai"   - OpenAI API (requires OPENAI_API_KEY)
AI_PROVIDER="fallback"

# Optional External AI API Keys (leave empty to use offline rule-based NLP)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# ==============================================================================
# File Upload Settings
# ==============================================================================
MAX_FILE_SIZE_MB=5

# ==============================================================================
# Free Geocoding Service (OpenStreetMap Nominatim)
# 100% Free - No Google Maps API Key or Billing Required
# ==============================================================================
GEOCODING_PROVIDER="nominatim"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="NammaCivicAI/1.0 (academic-civic-redressal-prototype; contact: student-demo@nammacivic.local)"
GEOCODING_COUNTRY_CODE="in"
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_TIMEOUT_SECONDS=6.0
